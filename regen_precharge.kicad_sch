	(text "INPUT"
		(at 17 27 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "55c4e09b-e3b2-4d00-afa0-0e3f600f3014")
	)
	(text "XT60 from the supply (fuse it in the supply lead). TVS D1 and bulk C17."
		(at 17 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cdb171f5-3bd8-42e0-bd48-d049364f2c06")
	)
	(text "White LED D8 = supply present."
		(at 17 35.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cf208691-7b34-4f8e-a54a-dcbfaae77aaa")
	)
	(text "IDEAL DIODE + SOFT START (U1 LM74800)"
		(at 137 27 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1345eb02-3a53-4241-b00b-cd265e8733a5")
	)
	(text "Q1||Q7 block regen into the supply. Q2||Q8 ramp the output at about 140 V/s (C4, C5, C13, C14 on CDVDT through R5). D11 clamps HGATE to VOUT + 12 V. SW1 = output on/off. UVLO ~13.5 V (R1/R2), OV ~57 V"
		(at 137 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb7075b6-e971-487b-83ee-30fc720a3382")
	)
	(text "(R3/R4)."
		(at 137 35.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "45d230e7-402c-46d7-b553-fbe579d47ff0")
	)
	(text "OUTPUT BUS"
		(at 467 27 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "79da4d1b-db7e-4cf3-bb14-ef8dff63e6cb")
	)
	(text "Four 470 uF 100 V bulk capacitors, ceramic C6 and TVS D2. Five XT30 outputs, 15 A each: 1-3 arm, 4 gripper, 5 spare."
		(at 467 32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ff669117-e1d3-458c-bbd3-86869a1fb4f8")
	)
	(text "11.6 V CONTROL RAIL"
		(at 17 170 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "131e2aa7-e80b-44e4-ae30-a2e6e8ef4c06")
	)
	(text "Made from VOUT, so it runs while the arm back-drives the bus. CJ431 (U2) sets Q4's base; D12 clamps it under 17 V; D10"
		(at 17 175 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f0f0b839-5fa0-4bce-9967-13bd4b15b54b")
	)
	(text "guards Q4's base-emitter. Green LED D3 = output live."
		(at 17 178.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e9f149ab-7d70-471f-8d3a-c33f852f4215")
	)
	(text "BRAKE COMPARATOR (U3A)"
		(at 212 170 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "295c8da8-4ab0-4874-ad47-f2d0fdff5720")
	)
	(text "Brakes when VOUT - VIN > 0.667 x V(TRIM) - 0.14 V. RV1 sets +3.0 to +7.5 V (clockwise raises it). R13 adds about 2.3 V of hysteresis."
		(at 212 175 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e4f6a5d5-8e44-4ecf-967d-f3eeb545a073")
	)
	(text "BRAKE DRIVER + MOSFETS"
		(at 467 170 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "bc4c5a9d-7f76-4c97-9c1a-795c8dc0480d")
	)
	(text "U4 (UCC27517) drives Q3||Q9 into the external resistor on J5 (2 ohm 200 W at 36 V, Q136 fuse in series). J11 = the resistor's thermal switch: open disables the brake. D4/D7 catch the resistor's kick."
		(at 467 175 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "66da8d71-5d10-46a4-9f37-1e43a9f0a577")
	)
	(text "BRAKE INTERLOCK"
		(at 17 310 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "273e75fe-bc40-45db-9827-b34f637a4ddc")
	)
	(text "Q10/Q11 hold CMP_OUT low while the ideal diode conducts (DGATE above VIN)."
		(at 17 315 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3363f1ce-8ee2-4e98-bf40-8cb80edb67bc")
	)
	(text "THERM OPEN LED"
		(at 172 310 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "df48d340-6793-498c-be58-9421a5b787e1")
	)
	(text "Yellow D9 lights when the J11 loop is open."
		(at 172 315 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0516dbe4-6ed4-4c8c-ba2d-515ac12b6d5a")
	)
	(text "RED BRAKE LED"
		(at 292 310 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f14efddd-17aa-4714-b965-4897c59556c1")
	)
	(text "U3B keeps red D6 lit for at least 0.3 s after any brake pulse (C12, R21)."
		(at 292 315 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5a4ba73b-52b1-412a-8325-001d6afa4ea1")
	)
	(text "MICROCONTROLLER HEADER"
		(at 597 310 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e8b99521-5fa2-432f-99c2-c35736e5ec47")
	)
	(text "J12: 1 GND, 2 BUS_ADC (VOUT x 0.053), 3 BRK_FLAG (open drain, low while braking)."
		(at 597 315 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cbf07ec7-96c0-4cbd-84d9-190fce2b5edc")
	)
	(text "TEST POINTS, MOUNTING, FIDUCIALS"
		(at 17 430 0)
		(effects
