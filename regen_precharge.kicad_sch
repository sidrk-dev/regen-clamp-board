	(text "POWER PATH: LM74800 ideal diode (Q1||Q7 block regen into the PSU) + soft-start (Q2||Q8, CdVdT = C4,C5,C13,C14)"
		(at 20 20 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "826887f2-acef-4fe1-a046-d6068bad3465")
	)
	(text "OUTPUT BUS: bulk caps, TVS backstop, 3 x XT30 outputs (each sized for the full 25 A supply)"
		(at 200 20 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "39049a16-ccfb-4c4d-b3bd-367b823688e3")
	)
	(text "30 A CONT / 60 A PEAK: paralleled MOSFETs, 2nd brake FET, thermal cut-off"
		(at 430 20 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "605bf97c-2955-4dc8-8cf8-5c680e7607cd")
	)
	(text "J11: normally-closed thermal switch on the brake resistors opens -> brake disabled"
		(at 430 210 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "263a0a09-0bac-4c8e-826f-a96427791810")
	)
	(text "11.6 V CONTROL RAIL (CJ431 + MMBT5551 follower)"
		(at 20 160 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "eb6df4e8-2f37-42a4-997a-572e56451878")
	)
	(text "REGEN CLAMP: brake ON at VOUT - VIN = 0.667 x V(TRIM) - 0.14 V (RV1 sets 3.0 to 7.6 V), OFF 2 V lower"
		(at 140 150 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "479ad1c9-2ef2-48bc-8051-bdbc95032301")
	)
	(text "LED STRETCHER: red LED stays on >= 0.3 s after any brake pulse"
		(at 295 150 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "5115df5d-a515-449b-99ea-9a7f39e63fc2")
	)
	(text "TEST POINTS (bare pads, not assembled)"
		(at 80 268 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f5578105-a438-41db-85e5-b84f492d0dd1")
	)
	(text "GATE RESISTORS R30-R33: one per paralleled FET (stops parasitic oscillation in linear soft start)"
		(at 20 30 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6a09d698-2e32-4fac-9945-2ab8378f4ff4")
	)
	(text "BRAKE INTERLOCK (Q10, Q11): brake held off while the ideal diode conducts"
		(at 505 150 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "33b81201-3b61-4a0b-8119-52b025d0a0aa")
	)
	(text "DEBUG LEDS: D8 white = supply present, D9 yellow = J11 thermal loop open (brake disabled)"
		(at 430 240 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ac7f5a16-b6b2-4a4b-ab29-c2fa03077ef2")
	)
	(text "SW1 OFF disconnects the output: plug motors with SW1 OFF. Supply 15-48 V."
		(at 20 145 0)
		(effects
			(font
				(size 1.27 1.27)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a34e4f5e-3717-4c38-a878-ee32758785ab")
	)
